# Secrets. Gemini key from Google AI Studio, on a billing-enabled project (see README about the terms).
GEMINI_API_KEY=
# Backups when Gemini fails or is slow
SUMOPOD_API_KEY=
POLLINATIONS_API_KEY=
APP_TOKEN=
# Local overrides of the settings in wrangler.jsonc (Gemini by default), e.g.:
# SPEECH_PROVIDER=google          # back to Google Cloud TTS/STT, then fill GOOGLE_CLOUD_API_KEY
# GEMINI_VOICE=Aoede
# TUTOR_MODEL=gemini-3.1-flash-lite
GOOGLE_CLOUD_API_KEY=
# Optional: a specific Google voice name per language (SPEECH_PROVIDER=google only)
TTS_VOICE_ID=
TTS_VOICE_EN=
