{
  "name": "pulaupintar-backend",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // Non-secret settings. API keys go in secrets: npx wrangler secret put GEMINI_API_KEY (and SUMOPOD_API_KEY, POLLINATIONS_API_KEY)
  "vars": {
    // Sumopod writes Kak Pinta's lines (deepseek-v4.1-flash:netra, reasoning off) and checks them (jev-1.13.0, TypeSafe's decision model,
    // called at Sumopod's /v1/systemone). Gemini (SPEECH_PROVIDER) speaks and hears: the app streams voice through
    // the Worker (/v1/live/speak and /v1/live/listen) to Gemini Live 3.8; /v1/tts and /v1/stt (also Gemini) are the
    // fallback when streaming isn't available. Time limits per call are in backend/src/tutor.ts.
    "TUTOR_PROVIDER": "sumopod",
    "TUTOR_MODEL": "deepseek-v4.1-flash:netra",
    "TUTOR_REASONING_EFFORT": "none",
    "SAFETY_PROVIDER": "sumopod",
    "SAFETY_MODEL": "jev-1.13.0",
    "SPEECH_PROVIDER": "gemini",
    "GEMINI_LIVE_MODEL": "gemini-3.8-live",
    "GEMINI_LISTEN_MODEL": "gemini-3.5-transcribe-live",
    // Backups when the main model errors, is slow or returns a cut-off reply.
    "TUTOR_FALLBACK_PROVIDER": "sumopod",
    "TUTOR_FALLBACK_MODEL": "claude-haiku-5-5",
    "SAFETY_FALLBACK_PROVIDER": "sumopod",
    "SAFETY_FALLBACK_MODEL": "claude-haiku-5-5"
  },
  // Per-IP limits per minute (Workers Rate Limiting). One child does about 3 turns a minute; a school class
  // shares one IP, so the limits leave room for about 40 children while still stopping a single abuser.
  "ratelimits": [
    { "name": "TURN_LIMITER", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "SPEECH_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } },
    { "name": "LIVE_LIMITER", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } }
  ]
}
